[Desktop Entry]
Name=Launcher Button
Comment=Open the launcher to search applications and run commands
Type=Application
Exec=Lingmo-panel-button com.lingmoos.LingmoLauncher
Terminal=false
Categories=Lingmo;
Keywords=Lingmo;Applet;Launcher;Runner;
Icon=com.lingmoos.LingmoPanelLauncherButton
StartupNotify=true
NoDisplay=true
X-LingmoApplet=true
X-OverflowPriority=10


